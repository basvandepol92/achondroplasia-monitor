RESEND_API_KEY=        # Aanmaken op resend.com (gratis tier: 100 mails/dag)
EMAIL_FROM=            # Moet een geverifieerd domein zijn in Resend, of gebruik onboarding@resend.dev voor testen
EMAIL_TO=              # E-mailadres van de ontvanger

NCBI_API_KEY=          # Optioneel, verhoogt PubMed rate limit
GOOGLE_API_KEY=        # Gemini Flash, voor AI-extractie als cheerio-scraper breekt

DB_PATH=./data/monitor.db
LOG_LEVEL=info

HEALTHCHECK_URL=       # Ping URL van healthchecks.io
